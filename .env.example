NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Public API URL used for payment redirect relay endpoints.
API_BASE_URL=https://api.rswater.ae

# Supabase Admin API. Keep the service role key backend-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
# Admin/driver API protection. Use long random values.
ADMIN_API_KEY=replace-with-long-random-admin-key
DRIVER_API_KEY=replace-with-long-random-driver-key

# Fixed driver login. Keep these backend-only and rotate the password regularly.
DRIVER_LOGIN_USERNAME=driver
DRIVER_LOGIN_PASSWORD=replace-with-a-strong-driver-password
DRIVER_LOGIN_ID=00000000-0000-4000-8000-000000000001
DRIVER_LOGIN_NAME=Delivery Driver
DRIVER_LOGIN_COUNT=7
WEBSITE_DISPATCH_URL=http://localhost:4000/api/dispatch/overview
WEBSITE_DISPATCH_WRITE_BASE_URL=http://localhost:4000/api/dispatch
WEBSITE_DISPATCH_WRITE_KEY=replace-with-the-website-dispatch-write-key
EMIRATE_BOUNDARIES_URL=http://localhost:3000/api/emirates
DRIVER_SESSION_SECRET=replace-with-a-separate-64-character-random-secret
DELIVERY_PROOF_BUCKET=delivery-proofs
DRIVER_REPORT_BUCKET=driver-day-reports
DRIVER_CUSTOMER_REQUEST_BUCKET=driver-customer-requests

# CORS. Comma-separated browser origins allowed in production.
FRONTEND_ALLOWED_ORIGINS=https://rswater.ae,https://admin.rswater.ae

# Network International / N-Genius.
NGENIUS_BASE_URL=https://api-gateway.ngenius-payments.com
NGENIUS_API_KEY=replace-with-ngenius-basic-api-key
NGENIUS_OUTLET_ID=replace-with-ngenius-outlet-id
NGENIUS_REDIRECT_URL=https://api.rswater.ae

# Mobile payment redirects.
APP_SCHEME=alrawdahsprings
CUSTOMER_APP_REDIRECT_URL=alrawdahsprings://payment-complete
CUSTOMER_APP_CANCEL_URL=alrawdahsprings://payment-cancel
CUSTOMER_APP_CHECKOUT_REDIRECT_URL=alrawdahsprings://checkout-complete
